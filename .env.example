NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Run once in Supabase SQL Editor:
# supabase/migrations/20260309_okapi_fullstack.sql
# supabase/migrations/20260309_share_public.sql

OKAPI_ADMIN_CODE=change-me-admin-code

# Supabase admin API (clients CRM) — Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (RDC: Gemini AI Studio is often blocked) ---
# Recommended from DRC: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MODEL_FLASH=gpt-5-mini
OPENAI_MODEL_PRO=gpt-5
LLM_PROVIDER=openai

# Optional OpenRouter (recommandé RDC)
OPENROUTER_API_KEY=
# Sans crédit : modèles :free — avec crédit : openai/gpt-5.6-luna + openai/gpt-6-astra
OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free
OPENROUTER_MODEL_FLASH=nex-agi/nex-n2.5-mini:free
OPENROUTER_MODEL_PRO=nex-agi/nex-n2.5-mini:free
OPENROUTER_SITE_URL=https://okapi-elf9.vercel.app

# Optional direct Gemini (works only from supported countries / VPN)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Optional Claude fallback
ANTHROPIC_API_KEY=

# --- Scalabilité / quotas LLM (par IP ou session) ---
OKAPI_DAILY_CHAT_LIMIT=80
OKAPI_DAILY_GENERATE_LIMIT=40
OKAPI_MAX_CONCURRENT_GENERATE=3

# --- Sécurité ---
# Ne jamais committer les clés. En prod, test routes sont OFF sauf :
# OKAPI_ALLOW_TEST_ROUTES=1
OKAPI_ALLOW_TEST_ROUTES=

# Images: /api/image utilise Pollinations (sans clé). Les HTML générés incluent aussi ces URLs.

# --- Mobile Pay (abonnements RDC) ---
# manual = demande + confirmation admin ; plus tard: flexpay / flutterwave
MOBILE_PAY_PROVIDER=manual
OKAPI_BILLING_WHATSAPP=243810000000
OKAPI_BILLING_WEBHOOK_SECRET=
# Run once: supabase/migrations/20260313_mobile_pay.sql

