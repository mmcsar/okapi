NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Run once in Supabase SQL Editor:
# supabase/migrations/20260309_okapi_fullstack.sql
# supabase/migrations/20260309_share_public.sql
# supabase/migrations/20260315_app_records.sql
# supabase/migrations/20260319_scheduled_tasks.sql

OKAPI_ADMIN_CODE=change-me-admin-code-12chars-min

# AES-256-GCM (sessions admin + champs KYC sensibles) — OBLIGATOIRE, distinct du code admin
# Génère : openssl rand -hex 32
OKAPI_AES_KEY=
# Optionnel (sinon OKAPI_AES_KEY suffit). Ne jamais réutiliser le code admin.
OKAPI_SESSION_SECRET=
# Dev uniquement : autoriser adminCode dans le body de /api/billing/confirm
# OKAPI_ALLOW_BODY_ADMIN_CODE=1

# Cron Automatisations (Vercel Cron → Authorization Bearer)
OKAPI_CRON_SECRET=
# Dev local: OKAPI_CRON_ALLOW_DEV=1 pour tester /api/cron/automations

# Supabase admin API (CRM + Ops + cron) - Dashboard > Settings > API Keys
# Nouveau format (recommande) : secret key sb_secret_...
SUPABASE_SECRET_KEY=
# Ancien format JWT (toujours accepte) :
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (RDC: Gemini AI Studio is often blocked) ---
# Recommended from DRC: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MODEL_FLASH=gpt-5-mini
OPENAI_MODEL_PRO=gpt-5
LLM_PROVIDER=openai

# Optional OpenRouter (recommandé RDC) — qualité type ChatGPT/Claude
OPENROUTER_API_KEY=
# Opus 5.5 Flash+Pro (Flash = effort medium/high, Pro = high/xhigh — pas un modèle :free).
OPENROUTER_MODEL=anthropic/claude-opus-5.5
OPENROUTER_MODEL_FLASH=anthropic/claude-opus-5.5
OPENROUTER_MODEL_PRO=anthropic/claude-opus-5.5
OPENROUTER_SITE_URL=https://okapi-elf9.vercel.app
# Images Agent (même clé OpenRouter) — PAS Opus : modèle image dédié
# Catalogue : google/gemini-2.5-flash-image · google/gemini-3.1-flash-image · flux.2-flex
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# Vidéo Agent (« crée une vidéo… ») — https://developers.heygen.com
HEYGEN_API_KEY=

# Optional images (Pollinations) — secondaire si OpenRouter indisponible
# https://enter.pollinations.ai/keys
POLLINATIONS_API_KEY=

# Optional direct Gemini (works only from supported countries / VPN)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Chat Agent, Studio et Preview (« Crée une app… ») utilisent cette clé dès qu'elle est posée (Opus).
# LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Scalabilité / quotas LLM (par IP ou session) ---
# Gratuit / invité (Flash seulement — jamais Opus)
OKAPI_FREE_DAILY_CHAT_LIMIT=20
OKAPI_FREE_DAILY_GENERATE_LIMIT=6
# Abonnés Entreprise Plus
OKAPI_DAILY_CHAT_LIMIT=80
OKAPI_DAILY_GENERATE_LIMIT=40
# Prod: 4 · Dev: 8 par défaut si non défini
OKAPI_MAX_CONCURRENT_GENERATE=8

# --- Sécurité ---
# Ne jamais committer les clés. En prod, test routes sont OFF sauf :
# OKAPI_ALLOW_TEST_ROUTES=1
OKAPI_ALLOW_TEST_ROUTES=

# Images: /api/image utilise Pollinations (sans clé). Les HTML générés incluent aussi ces URLs.

# --- Mobile Pay (abonnements RDC) ---
# manual = demande + confirmation admin ; plus tard: flexpay / flutterwave
MOBILE_PAY_PROVIDER=manual
OKAPI_BILLING_WHATSAPP=243810000000
OKAPI_BILLING_WEBHOOK_SECRET=
# Taux USD → CDF pour Mobile Money (Entreprise Plus = 15 USD)
OKAPI_USD_CDF_RATE=2800
# Run once:
# supabase/migrations/20260313_mobile_pay.sql
# supabase/migrations/20260313_kyc_profiles.sql

